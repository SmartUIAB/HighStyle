# Copy locally to .env. These are examples, not production credentials.
NODE_ENV=development
APP_ENV=development
RELEASE_SHA=
PORT=2024
MONGODB_ATLAS=mongodb://127.0.0.1:27017/highstyle_dev?replicaSet=rs0
JWT_SECRET=replace-with-a-strong-random-secret-before-running
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# Optional; do not set to an unrelated domain.
# COOKIE_DOMAIN=.your-domain.example
TRUST_PROXY_HOPS=0
# Comma-separated reviewed existing administrator IDs; empty denies global operations.
PLATFORM_ADMIN_IDS=
# Default off until hosted payment, inventory and migration acceptance.
PAYMENTS_ENABLED=false
STRIPE_MODE=test
# Set only following separate explicit production payment approval.
LIVE_PAYMENTS_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Password reset SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
USER_EMAIL=
USER_EMAIL_PASSWORD=
# Password resets and the receipt outbox share this SMTP transport.
# Staging: use an isolated Mailpit with SMTP_PORT=1025 and no SMTP auth.
